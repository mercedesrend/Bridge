# Next.js visit companion. Force scripted mode before going on stage.
FORCE_SCRIPTED=false

# Optional live model (otherwise the demo uses scripted fixtures).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional. Raises NCBI rate limit from 3/s to 10/s.
NCBI_API_KEY=
CONTACT_EMAIL=you@example.com

REQUEST_TIMEOUT=30
MAX_STUDIES=6
