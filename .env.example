# Required: model API key used by Ask Bridge and trial matching.
OPENROUTER_API_KEY=your_key_here
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional: override the matching model (defaults to gpt-4.1-nano).
OPENAI_MODEL=gpt-4.1-nano
OPENAI_ASK_MODEL=

# Optional: turn on Clerk auth for the dashboard and companion flows.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
