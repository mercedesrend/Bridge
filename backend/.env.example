# Amazon Bedrock (hackathon default). Redeem AWS credits, then:
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5
USE_BEDROCK=true

# Optional fallback if Bedrock is not enabled in the account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional. Raises NCBI rate limit from 3/s to 10/s.
NCBI_API_KEY=
CONTACT_EMAIL=you@example.com

# Optional. Only used for fetching pages that block plain requests.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=web_unlocker1

# Flip to true right before demoing to force scripted mode.
FORCE_SCRIPTED=false

REQUEST_TIMEOUT=30
MAX_STUDIES=6
